# Environment variables read by config/settings.py (export them in your shell; never commit real values).
DEBUG=1
# SECRET_KEY=            # required when DEBUG=0
# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# DATABASE_URL=...   # unset -> SQLite. Locally, `neon deploy` writes it to ../.env.local (auto-loaded, gitignored)
# LOGIN_THROTTLE_RATE=10/min
